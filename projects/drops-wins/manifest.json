{
  "version": 1,
  "fields": {
    "hero.kicker": { "type": "text", "label": "Hero kicker", "block": "Hero", "maxLength": 40 },
    "hero.title": { "type": "heading", "label": "Hero headline", "block": "Hero", "level": 1, "maxLength": 70 },
    "hero.prizePool": { "type": "text", "label": "Prize pool figure", "block": "Hero", "maxLength": 30 },
    "hero.subtitle": { "type": "text", "label": "Hero subline", "block": "Hero", "maxLength": 140 },
    "hero.banner": { "type": "image", "label": "Hero banner", "block": "Hero", "ratio": "16:7", "minWidth": 1440, "altRequired": true, "priority": true },
    "hero.cta": { "type": "button", "label": "Primary CTA", "block": "Hero", "external": true, "defaultRel": "nofollow sponsored", "variant": "primary" },

    "steps.heading": { "type": "heading", "label": "Steps heading", "block": "Steps", "level": 2, "maxLength": 60 },
    "steps.items": {
      "type": "repeat", "label": "How it works steps", "block": "Steps", "min": 3, "max": 5,
      "item": {
        "icon": { "type": "icon", "label": "Step icon", "block": "Steps" },
        "title": { "type": "text", "label": "Step title", "block": "Steps", "maxLength": 40 },
        "text": { "type": "text", "label": "Step text", "block": "Steps", "maxLength": 160 }
      }
    },

    "daily.heading": { "type": "heading", "label": "Daily table heading", "block": "DailyTable", "level": 2, "maxLength": 60 },
    "daily.intro": { "type": "text", "label": "Daily table intro", "block": "DailyTable", "maxLength": 200 },
    "daily.scoring": { "type": "text", "label": "Scoring explanation", "block": "DailyTable", "maxLength": 200 },
    "daily.rows": {
      "type": "repeat", "label": "Daily prize rows", "block": "DailyTable", "min": 5, "max": 12,
      "item": {
        "rank": { "type": "text", "label": "Rank", "block": "DailyTable", "maxLength": 12 },
        "prize": { "type": "text", "label": "Prize", "block": "DailyTable", "maxLength": 20 }
      }
    },

    "drops.heading": { "type": "heading", "label": "Drops table heading", "block": "DropsTable", "level": 2, "maxLength": 60 },
    "drops.intro": { "type": "text", "label": "Drops table intro", "block": "DropsTable", "maxLength": 200 },
    "drops.rows": {
      "type": "repeat", "label": "Weekly drop rows", "block": "DropsTable", "min": 5, "max": 12,
      "item": {
        "quantity": { "type": "text", "label": "Quantity", "block": "DropsTable", "maxLength": 12 },
        "prize": { "type": "text", "label": "Prize", "block": "DropsTable", "maxLength": 24 }
      }
    },

    "games.heading": { "type": "heading", "label": "Games heading", "block": "Games", "level": 2, "maxLength": 60 },
    "games.items": {
      "type": "repeat", "label": "Eligible games", "block": "Games", "min": 4, "max": 12,
      "item": {
        "thumb": { "type": "image", "label": "Game thumbnail", "block": "Games", "ratio": "1:1", "altRequired": true },
        "name": { "type": "text", "label": "Game name", "block": "Games", "maxLength": 40 },
        "provider": { "type": "text", "label": "Provider", "block": "Games", "maxLength": 40 }
      }
    },

    "faq.heading": { "type": "heading", "label": "FAQ heading", "block": "Faq", "level": 2, "maxLength": 60 },
    "faq.items": {
      "type": "repeat", "label": "FAQ entries", "block": "Faq", "min": 2, "max": 12,
      "item": {
        "q": { "type": "text", "label": "Question", "block": "Faq", "maxLength": 120 },
        "a": { "type": "text", "label": "Answer", "block": "Faq", "maxLength": 400 }
      }
    },

    "footer.heading": { "type": "heading", "label": "Footer heading", "block": "Footer", "level": 2, "maxLength": 60 },
    "footer.note": { "type": "richtext", "label": "Footer note", "block": "Footer" },
    "footer.link": { "type": "link", "label": "Responsible play link", "block": "Footer", "external": true, "defaultRel": "nofollow sponsored" },
    "footer.ageIcon": { "type": "icon", "label": "18+ mark", "block": "Footer" },

    "seo.title": { "type": "text", "label": "SEO title", "block": "_seo", "maxLength": 60, "derivedFrom": "hero.title" },
    "seo.description": { "type": "text", "label": "Meta description", "block": "_seo", "maxLength": 155, "derivedFrom": "hero.subtitle" },
    "seo.slug": { "type": "text", "label": "Slug", "block": "_seo", "derivedFrom": "hero.title" },
    "seo.canonical": { "type": "text", "label": "Canonical", "block": "_seo" },
    "seo.robots": { "type": "text", "label": "Robots", "block": "_seo" },
    "seo.lang": { "type": "text", "label": "Language", "block": "_seo" },
    "seo.hreflang": { "type": "text", "label": "Hreflang", "block": "_seo" },
    "seo.og.title": { "type": "text", "label": "OG title", "block": "_seo", "maxLength": 60 },
    "seo.og.description": { "type": "text", "label": "OG description", "block": "_seo", "maxLength": 155 },
    "seo.og.image": { "type": "image", "label": "OG image", "block": "_seo", "derivedFrom": "hero.banner" },
    "seo.og.type": { "type": "text", "label": "OG type", "block": "_seo" },
    "seo.twitter.card": { "type": "text", "label": "Twitter card", "block": "_seo" },
    "seo.focusKeyword": { "type": "text", "label": "Focus keyword", "block": "_seo" },
    "seo.secondaryKeywords": { "type": "text", "label": "Secondary keywords", "block": "_seo" },
    "seo.author": { "type": "text", "label": "Author", "block": "_seo" },
    "seo.datePublished": { "type": "text", "label": "Date published", "block": "_seo" },
    "seo.dateModified": { "type": "text", "label": "Date modified", "block": "_seo" },
    "seo.schema.types": { "type": "text", "label": "Schema types", "block": "_seo" },
    "seo.schema.faq": { "type": "text", "label": "Schema FAQ", "block": "_seo" },
    "seo.breadcrumb": { "type": "text", "label": "Breadcrumb", "block": "_seo" }
  }
}

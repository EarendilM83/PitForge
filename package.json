{
  "name": "pitforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "export": "node --import ./scripts/register-tsx.mjs src/cli/export.ts",
    "import": "node --import ./scripts/register-tsx.mjs src/cli/import.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-responsive.mjs",
    "test:ui": "node scripts/test-pipeline.mjs",
    "test:sites": "node scripts/test-pipeline.mjs --sites-only",
    "test:editor": "node scripts/test-pipeline.mjs --editor-only",
    "gate": "npm run typecheck && npm run test:ui",
    "qa:run": "node scripts/qa-run.mjs --project",
    "qa:setup": "node scripts/qa-setup.mjs --project"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
